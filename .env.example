# --- Database (Neon) ---
# Neon dashboard > your project > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# --- Security ---
# Any long random text. Change it. Example: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Google sign-in ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add http://localhost:3000 (and your live domain) under "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=

# --- First admin (created on first start) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

PORT=3000

# Add this under "Authorized redirect URIs" too (for sign-in inside the Android app):
#   https://YOUR-SITE/auth/google/callback
